{
  "compilerOptions": {
    "types": ["node"],
    "target": "ESNext",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "./**/*"
  ],
  "exclude": [
    "./_generated"
  ]
}
